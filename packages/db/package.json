{
  "name": "@idf/db",
  "private": true,
  "type": "module",
  "exports": {
    "./catalog": "./src/catalog.ts",
    "./orders": "./src/orders.ts",
    "./invoicing": "./src/invoicing.ts",
    "./stripe": "./src/stripe.ts",
    "./paypal": "./src/paypal.ts",
    "./notices": "./src/notices.ts",
    "./mail-outbox": "./src/mail-outbox.ts",
    "./customer-mails": "./src/customer-mails.ts",
    "./invoice-pdf": "./src/invoice-pdf.ts",
    "./billing": "./src/billing.ts",
    "./auth": "./src/auth.ts",
    "./admin": "./src/admin.ts",
    "./refunds": "./src/refunds.ts",
    "./webhooks": "./src/webhooks.ts",
    "./legal": "./src/legal.ts"
  },
  "scripts": {
    "migrate": "tsx src/cli.ts",
    "thrivecart:import": "tsx src/thrivecart-cli.ts",
    "thrivecart:history": "tsx src/thrivecart-history-cli.ts",
    "company:create": "tsx src/company-cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "mail:send": "tsx src/mail-cli.ts",
    "webhooks:send": "tsx src/webhooks-cli.ts",
    "grants": "tsx src/grants-cli.ts"
  },
  "dependencies": {
    "@idf/core": "workspace:*",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
