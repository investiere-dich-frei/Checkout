# Von Ansible verwaltet (roles/app). Werte aus group_vars/app/secrets.sops.yml.
NODE_ENV=production
PUBLIC_BASE_URL=https://{{ checkout_domain }}
DATABASE_URL=postgres://idf_app:{{ pg_app_password | urlencode }}@{{ hostvars[groups['db'][0]].private_ip }}:5432/idf?sslmode=require&uselibpqcompat=true
STRIPE_SECRET_KEY={{ stripe_secret_key | default('') }}
STRIPE_PUBLISHABLE_KEY={{ stripe_publishable_key | default('') }}
STRIPE_WEBHOOK_SECRET={{ stripe_webhook_secret | default('') }}
PAYPAL_CLIENT_ID={{ paypal_client_id | default('') }}
PAYPAL_CLIENT_SECRET={{ paypal_client_secret | default('') }}
PAYPAL_WEBHOOK_ID={{ paypal_webhook_id | default('') }}
PAYPAL_ENV={{ paypal_env | default('sandbox') }}
GRAPH_TENANT_ID={{ graph_tenant_id }}
GRAPH_CLIENT_ID={{ graph_client_id }}
GRAPH_CLIENT_SECRET={{ graph_client_secret }}
MAIL_FROM={{ checkout_mail_from }}
OUTBOUND_WEBHOOK_URL={{ outbound_webhook_url | default('') }}
OUTBOUND_WEBHOOK_SECRET={{ outbound_webhook_secret | default('') }}
